# Backend only. Never prefix these with VITE_ — anything VITE_* is shipped to the browser.
YOUCAM_API_KEY=
YOUCAM_API_BASE=https://yce-api-01.makeupar.com
PORT=8787
# Optional: Murf text-to-speech for the spoken angle guide and result. Without it, the phone's own voice is used.
MURF_API_KEY=
MURF_VOICE_ID=en-US-natalie
