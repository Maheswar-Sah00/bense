{
  "catalogueVersion": "dev-2026-10-16",
  "status": "illustrative",
  "notice": "Illustrative development shades, not real products. Swatches show a modelled target colour, not any brand's formula or box colour.",
  "colourModel": {
    "description": "targetHex = Lab(L*, a*, b*) converted to sRGB, where L* = 12 + 7 × (level − 1) and a*/b* come from the tone: neutral (4, 16), ash (1, 9), golden (6, 28), copper (20, 30), pearl (6, 2), mocha (5, 10), red (32, 22), mahogany (24, 8). Tone chroma was raised from the tests/boxtruth.py values after live Hair Color renders showed the original ash as grey.",
    "status": "uncalibrated",
    "sourceIds": [
      "boxtruth-model"
    ]
  },
  "sources": {
    "boxtruth-model": {
      "title": "Box Truth tone model in tests/boxtruth.py (uncalibrated level bands, to be fitted against real photos)",
      "url": null
    },
    "level-numbering": {
      "title": "Common level.tone numbering on box dyes (e.g. 7.1). Tone digits differ between brands; not verified per brand.",
      "url": null
    },
    "garnier-lift": {
      "title": "Garnier USA, New to Hair Color: permanent colour lifts 2–3 levels; another box won't lighten dyed hair without bleach",
      "url": "https://www.garnierusa.com/en/hair-color-needs/new-to-hair-color"
    },
    "theshade-dyed": {
      "title": "The Shade help centre: hair colour can't lighten hair that has already been permanently coloured",
      "url": "https://the-shade.helpscoutdocs.com/article/52-how-light-can-i-colour-my-hair"
    },
    "underlying-pigment": {
      "title": "Open Exam Prep, colour formulation and correction: lifting exposes red → orange → gold → yellow",
      "url": "https://open-exam-prep.com/study-guides/tx-barber/haircoloring/color-formulation-correction"
    },
    "ash-green": {
      "title": "CurlCentric, Why is my hair turning green: ash pigments on yellow or porous hair can turn green",
      "url": "https://www.curlcentric.com/why-is-my-hair-turning-green-when-i-dye-it/"
    },
    "revlon-dark": {
      "title": "Revlon Professional: previously dyed hair can take twice as long to lighten per level",
      "url": "https://cdn.revlonprofessional.com/blog/correct-black-box-dyed-hair"
    },
    "swatch-approx": {
      "title": "Clairol (via Happi): colour swatches are electronic approximations; results on hair vary",
      "url": "https://www.happi.com/contents/view_breaking-news/2016-11-14/clairol-creates-new-shade-selection-app/"
    }
  },
  "limitations": {
    "swatch-approximation": {
      "text": "The swatch is an approximation. Real results depend on your starting colour and hair condition.",
      "sourceIds": [
        "swatch-approx"
      ]
    },
    "lift-limit": {
      "text": "Box dye lifts natural hair about 2–3 levels at most, so starting much darker it will stop short.",
      "sourceIds": [
        "garnier-lift"
      ]
    },
    "dye-cant-lift-dye": {
      "text": "It can't lighten hair that's already been dyed. Only bleach can.",
      "sourceIds": [
        "garnier-lift",
        "theshade-dyed"
      ]
    },
    "warm-exposure": {
      "text": "Lightening exposes warm pigment (red, orange, gold, yellow), so results often look warmer than the box.",
      "sourceIds": [
        "underlying-pigment"
      ]
    },
    "ash-green": {
      "text": "Ash tones can turn green on yellow, porous or previously lightened hair.",
      "sourceIds": [
        "ash-green"
      ]
    },
    "dark-hard-to-undo": {
      "text": "Going this dark is reliable but hard to undo: dyed hair is much slower to lighten later.",
      "sourceIds": [
        "revlon-dark"
      ]
    }
  },
