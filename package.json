{
  "name": "bense",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "start:api": "tsx server/index.ts",
    "start": "tsx server/index.ts --serve-app",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "tsx e2e/capture.e2e.ts",
    "test:pwa": "vite build && tsx e2e/pwa.e2e.ts",
    "smoke:tones": "tsx server/scripts/smoke-colour-tones.ts",
    "smoke:level": "tsx e2e/smoke-level.ts",
    "smoke:reveal": "tsx server/scripts/smoke-reveal.ts",
    "smoke:hair": "tsx server/scripts/smoke-hair.ts",
    "smoke:walkthrough": "tsx e2e/live-walkthrough.ts"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1",
    "fastify": "^5.12.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
