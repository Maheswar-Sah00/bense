   "boundElements": null,
   "updated": 1792222579955,
   "link": null,
   "locked": false,
   "text": "Blonde sample: L* 58.5 = level 8 (same value from two renders hours apart)\nDark base: L* 23.4 = level 3.   Tightly curled sample: L* 8.4 = level 1 (shadows)\nOne level = 7 L*.  You always confirm the level, or nudge it by one.",
   "fontSize": 18,
   "fontFamily": 1,
   "textAlign": "center",
   "verticalAlign": "middle",
   "baseline": 60,
   "containerId": "f",
   "originalText": "Blonde sample: L* 58.5 = level 8 (same value from two renders hours apart)\nDark base: L* 23.4 = level 3.   Tightly curled sample: L* 8.4 = level 1 (shadows)\nOne level = 7 L*.  You always confirm the level, or nudge it by one.",
   "lineHeight": 1.25
  }
 ],
